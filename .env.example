# Copy to .env and fill in what you need. Defaults run in mock mode — no keys required.

PORT=3000
NODE_ENV=development

# mock | openai | deepgram
TRANSCRIPTION_PROVIDER=mock
OPENAI_API_KEY=

# mock | anthropic
ANALYSIS_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# local | s3
STORAGE_DRIVER=local
DATA_DIR=./data

# Max upload size in MB
MAX_UPLOAD_MB=500
